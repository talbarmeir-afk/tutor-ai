# Copy this file to .env for local development with the Netlify or Vercel CLI.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables the guest daily-check limit (lib/guestLimit.js) and the
# weekly progress-report emails (lib/progressReport.js). Without it, checks/
# hints work as normal but the limit silently doesn't apply to anyone, and
# the weekly report cron sends nothing. Get this from Supabase: Project
# Settings -> API -> service_role secret key. Keep it out of the browser
# entirely — it bypasses Row Level Security, unlike the anon key already
# hardcoded in index.html.
SUPABASE_SERVICE_ROLE_KEY=

# Required for weekly progress-report emails. Get a key at resend.com
# (free tier works fine to start) — until a sending domain is verified
# there, mail can only go out from their onboarding@resend.dev address,
# which is fine for testing but looks unpolished for real use.
RESEND_API_KEY=

# Optional: overrides the default "Claruno <onboarding@resend.dev>" sender
# once you've verified a domain in Resend, e.g. "Claruno <reports@claruno.ai>".
PROGRESS_REPORT_FROM=

# The site's real URL, used to build the unsubscribe link in progress-report
# emails. Falls back to https://claruno.ai if unset.
APP_BASE_URL=https://claruno.ai

# Optional but recommended: locks down /api/cron/send-progress-reports on
# Vercel so only Vercel's own cron trigger can call it, not anyone who finds
# the URL — set any random string here, Vercel sends it back automatically
# as a bearer token on cron-triggered requests. Netlify Scheduled Functions
# aren't reachable by a public URL the normal way, so this only matters on
# Vercel.
CRON_SECRET=
