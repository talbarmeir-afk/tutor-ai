# Copy this file to .env for local development with the Netlify or Vercel CLI.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables the guest daily-check limit (lib/guestLimit.js). Without
# it, checks/hints work as normal but the limit silently doesn't apply to
# anyone. Get this from Supabase: Project Settings -> API -> service_role
# secret key. Keep it out of the browser entirely — it bypasses Row Level
# Security, unlike the anon key already hardcoded in index.html.
SUPABASE_SERVICE_ROLE_KEY=
